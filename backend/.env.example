# EarthScape Climate Agency — environment template
# Copy to `.env` at the repository root. NEVER commit the real `.env`.
# Every value below is a placeholder. Do not paste production credentials into this file.

# ------------------------------------------------------------------ Django core
DJANGO_SECRET_KEY=generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEPLOYMENT_ENVIRONMENT=development
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --------------------------------------------------------------------- Frontend
# Comma-separated exact origins allowed by the CORS middleware.
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_SITE_NAME=EarthScape Climate Agency

# ------------------------------------------------------------ MongoDB Atlas
# MongoDB Atlas is the PRIMARY application database.
# Create a user in Atlas Database Access, allow your IP in Network Access, then:
# Paste the connection string from Atlas verbatim (either the mongodb:// shard list or
# the mongodb+srv form) and put the credentials in their own keys below. A URI that
# still contains <db_username>/<username> or <db_password>/<password> counts as unset,
# so the backend never tries to authenticate with a literal placeholder.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_ATLAS_USER=
MONGODB_ATLAS_PASSWORD=
MONGODB_DATABASE=earthscape_climate
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=30000
# true  -> startup fails if Atlas is unreachable (production behaviour)
# false -> fall back to the documented local-development document store
FORCE_ATLAS_CONNECTION=false

# ---------------------------------------------------------------------- JWT auth
JWT_SIGNING_KEY=generate-with-python-secrets-token_urlsafe-64
JWT_ISSUER=earthscape-climate-agency
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=7
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_SYMBOL=true
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# --------------------------------------------------------------- account workflow
# The platform is provisioned with a single administrator account. Self-registration
# creates the least-privileged role (viewer), so leave it off unless you want signups.
ENABLE_SELF_REGISTRATION=false
ALLOW_ANALYST_SELF_REGISTRATION=false
ENABLE_PASSWORD_RESET=true
DEFAULT_THEME=light

# ------------------------------------------------------------- bootstrap account
# Email of the operator account created by backend/scripts/bootstrap_platform.py.
BOOTSTRAP_ADMIN_EMAIL=Earthscape@admin.com
# Leave blank to have a strong random password generated and written once to
# backend/.data/bootstrap-credentials.txt. Set it only in a real .env, never here.
BOOTSTRAP_ADMIN_PASSWORD=

# ------------------------------------------------------------------- data sources
# NASA POWER needs no API key, only network access.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT_SECONDS=45
NASA_POWER_MAX_POINTS_PER_RUN=24
# NOAA Climate Data Online: register at https://www.ncdc.noaa.gov/cdo-web/token
NOAA_API_KEY=
NOAA_BASE_URL=https://www.ncdc.noaa.gov/cdo-web/api/v2
NOAA_TIMEOUT_SECONDS=45
NOAA_RATE_LIMIT_PER_MINUTE=30
# Configurable live-weather provider (open-meteo is key-free and used by default)
LIVE_CLIMATE_PROVIDER=open_meteo
LIVE_CLIMATE_API_KEY=
LIVE_CLIMATE_BASE_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------ file ingestion
MAX_UPLOAD_BYTES=52428800
MAX_UPLOAD_ROWS=500000
ALLOWED_UPLOAD_EXTENSIONS=.csv,.json,.txt,.nc,.parquet,.xls,.xlsx,.xlsm,.xlsb,.xltx,.xltm,.ods
# Optional: password used to open workbook-encrypted .xlsx/.xlsm/.xls/.xlsb uploads.
# Leave empty to refuse encrypted files instead of prompting per upload.
UPLOAD_FILE_PASSWORD=
# Guards .ods files that store thousands of empty repeated columns.
ODS_MAX_COLUMN_REPEAT=4096
LOCAL_DATA_ROOT=

# ------------------------------------------------------------------- big data layer
# HDFS WebHDFS endpoint. Leave empty to use the local data-lake directory.
HDFS_ENDPOINT=http://localhost:9870
HDFS_ROOT=/user/earthscape
HDFS_USER=hadoop
DATA_LAKE_LOCAL_ROOT=
DATA_LAKE_BACKEND=auto
# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=earthscape-climate-processing
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_MIN_PARALLELISM=4
SPARK_ENABLED=true
# Hadoop MapReduce (Hadoop Streaming job runner)
HADOOP_BIN=
HADOOP_DISTCP_ENABLED=false
MAPREDUCE_RUNNER=auto
# Kafka / Structured Streaming
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_CLIMATE=climate.observations.v1
KAFKA_CONSUMER_GROUP=earthscape-processing
STREAMING_TRIGGER_SECONDS=30

# ---------------------------------------------------------------- background tasks
# When reachable, Celery is used. Otherwise an in-process worker pool runs the same tasks.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
BACKGROUND_WORKERS=4

# --------------------------------------------------------------------- Airflow
AIRFLOW_ENABLED=false
AIRFLOW_HOME=
AIRFLOW_DAG_ID=earthscape_daily_sync
AIRFLOW_BASE_URL=http://localhost:8081

# ---------------------------------------------------------------------- machine learning
MODEL_ARTIFACT_DIR=
MODEL_CONTAMINATION=0.02
FORECAST_MAX_HORIZON_DAYS=180
MLFLOW_ENABLED=false
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=earthscape-climate

# -------------------------------------------------------------------- notifications
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM_ADDRESS=
ALERT_COOLDOWN_MINUTES=60
NOTIFICATION_MAX_ATTEMPTS=5

# --------------------------------------------------------------------- operations
RATE_LIMIT_DEFAULT=600
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_PASSWORD_RESET=5
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_TICKETS=10
RATE_LIMIT_FEEDBACK=10
# Aggregate reads cost a collection scan, so they carry their own per-client count.
RATE_LIMIT_ANALYTICS=60
PROCESSING_SCRATCH_DIR=
HEALTH_CHECK_TIMEOUT_SECONDS=5

# --------------------------------------------------- runtime tunables (defaults)
# Each of these is read by the application; the value shown is the coded default,
# so leaving a line commented out changes nothing.
