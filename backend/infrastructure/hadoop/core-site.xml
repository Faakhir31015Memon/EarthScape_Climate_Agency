<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  EarthScape Climate Agency - pseudo-distributed HDFS core settings.

  Source of truth for the four Hadoop daemons in infrastructure/docker/docker-compose.yml:
  each service bind-mounts this directory read-only over /opt/hadoop/etc/hadoop inside
  apache/hadoop:3.3.6, so these files - not environment variables - decide what the daemons do.
  The container names below (hadoop-namenode, hadoop-datanode, hadoop-resourcemanager,
  hadoop-nodemanager, hadoop-history-server) are the compose service names, so the ports listed
  here are the ports published on the host by that file.

  Layout: one NameNode + one DataNode + one ResourceManager + one NodeManager. This is what
  Hadoop calls pseudo-distributed: real HDFS and real MapReduce on YARN, with a single worker,
  so a replication factor above 1 could never be satisfied.

  The Django API never talks to these ports. It reads and writes the lake over WebHDFS (see
  hdfs-site.xml and HDFS_WEBHDFS_URL in infrastructure/docker/.env.example) because
  common/datalake.py only needs the HTTP surface, not a JVM client.
-->
<configuration>

  <!-- The single authority every `hdfs`/`hadoop fs`/`spark-submit` command resolves against.
       8020 is the classic IPC port but 9000 is what the compose file publishes, so the two are
       kept identical to stop "works in the container, fails from the host" confusion. -->
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://hadoop-namenode:9000</value>
    <description>RPC address of the NameNode; hdfs:/// paths without an authority land here.</description>
  </property>

  <!-- Where `hadoop fs -mkdir /earthscape/...` starts. infrastructure/docker/Dockerfile.backend
       and the hadoop-namenode command both create ${HDFS_ROOT}/datalake/{raw,validated,processed,
       analytics,ml-features,exports}, and /api/v1/processing/mapreduce lists those layers. -->
  <property>
    <name>fs.hdfs.impl.disable.cache</name>
    <value>false</value>
    <description>Keep the DistributedFileSystem client cache on so the daemons reuse connections.</description>
  </property>

  <!-- The stack has no Kerberos: authentication is the operating-system user (simple auth), and
       WebHDFS requests carry user.name=hadoop. Set dfs.security.enabled only in a deployment that
       actually installs a KDC - with the current compose file HDFS is reachable from the private
       network only, never from the internet. -->
  <property>
    <name>hadoop.http.filter.initializers</name>
    <value>org.apache.hadoop.http.lib.StaticUserWebFilter</value>
    <description>Serves the NameNode/ResourceManager UIs as the static user instead of requiring a login.</description>
  </property>

  <!-- The daemons run as the image user `hadoop`; without these proxy-user rules a WebHDFS call
       from a different user.name is refused, which is exactly how "the lake looks empty" bugs
       start. The API sends user.name=${HADOOP_USER} (hadoop). -->
  <property>
    <name>hadoop.proxyuser.hadoop.hosts</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hadoop.groups</name>
    <value>*</value>
  </property>

  <!-- Tuning that matters for the sizes in this repository: provider JSONL batches of a few
       hundred thousand lines, and MapReduce Streaming jobs that emit far fewer records than they
       read. 128 KB is the Hadoop default; raising it helps the many-small-records pattern. -->
  <property>
    <name>io.file.buffer.size</name>
    <value>262144</value>
  </property>

  <!-- A container network can drop a connection while a node restarts; two retries keeps the
       client honest instead of silently retrying forever against a dead NameNode. -->
  <property>
    <name>ipc.client.connect.max.retries</name>
    <value>3</value>
  </property>
  <property>
    <name>ipc.client.connect.retry.interval</name>
    <value>2000</value>
  </property>

  <!-- Trash is deliberately OFF. The application owns retention:
       common/datalake.publish_raw_file writes into dated partitions and the API exposes no delete
       route, so a `rmr` from an operator should be permanent rather than invisible for a day. -->
  <property>
    <name>fs.trash.interval</name>
    <value>0</value>
  </property>

  <!-- Local file:// paths stay allowed so the same configuration runs the mapreduce/local_runner.py
       route (MAPREDUCE_MODE=streaming-local) against artifacts/datalake without editing anything;
       infrastructure/docker/.env.example switches DATA_LAKE_ENGINE back to local for that. -->
  <property>
    <name>fs.AbstractFileSystem.file.impl</name>
    <value>org.apache.hadoop.fs.local.LocalFs</value>
  </property>

  <!-- No ZooKeeper in this stack: YARN failover and HDFS HA are both single-node by design, so
       there is no quorum to configure. Recorded here so nobody hunts for a zoo.cfg. -->

</configuration>
