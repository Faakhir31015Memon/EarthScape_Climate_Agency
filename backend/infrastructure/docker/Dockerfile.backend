# EarthScape Climate Agency — backend image (Django REST + PyMongo + Spark/MapReduce paths).
#
# Python 3.11 is used deliberately: the ML/big-data dependencies pinned in
# backend/requirements.txt (pyspark, xgboost) are marked `python_version < "3.12"` and
# would be silently skipped on a 3.12 base image, which would leave the processing and
# model-training endpoints non-functional.
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Java is required by PySpark; curl is used by the readiness probe.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless curl tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt backend/requirements.txt
RUN pip install -r backend/requirements.txt gunicorn==22.0.0

COPY backend/ backend/

# Never run the API as root, and never bake secrets into the image.
RUN useradd --create-home --uid 10001 earthscape \
    && mkdir -p /app/backend/.data/uploads /app/backend/.data/reports /app/backend/.data/exports /app/backend/.data/ml-artifacts /app/.data-lake \
    && chown -R earthscape:earthscape /app
USER earthscape

ENV DJANGO_SETTINGS_MODULE=config.settings \
    PYTHONPATH=/app/backend \
    LOCAL_DATA_ROOT=/app/backend/.data \
    DATA_LAKE_LOCAL_ROOT=/app/.data-lake \
    MODEL_ARTIFACT_DIR=/app/backend/.data/ml-artifacts

WORKDIR /app/backend
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8000/api/v1/ready || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-"]
