# EarthScape Climate Agency - container stack configuration.
#
#   cp infrastructure/docker/.env.example infrastructure/docker/.env
#
# Compose interpolates ${VAR} in docker-compose.yml from this file and also passes every value
# to the containers through env_file, so anything the backend reads with ENV.raw works here too.
# Keys whose literal value the compose file pins (container paths such as ARTIFACTS_ROOT,
# DATA_LAKE_ROOT, REPORT_STORAGE_ROOT, MODEL_ARTIFACT_ROOT, REDIS_URL) are documented in the
# x-backend-env anchor of docker-compose.yml instead, because the anchor overrides the file.
#
# Every value marked GENERATE has no safe default: compose refuses to start rather than fall
# back to a well-known secret. The repository ignores .env and .env.* and commits only this file.
# No credential below is real.

# ------------------------------------------------------------------- runtime identity
COMPOSE_PROJECT_NAME=earthscape-climate-agency
TZ=UTC

# ------------------------------------------------------------ django / api (GENERATE all)
# openssl rand -base64 48  (or: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())")
DJANGO_SECRET_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://nginx
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
BACKEND_PORT_BIND=127.0.0.1
BACKGROUND_WORKERS=4

# ------------------------------------------------------------------------ api behaviour
# Keys the backend reads directly (not interpolated by compose, forwarded by env_file).
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_ISSUER=earthscape-climate-agency
LOG_BACKUP_COUNT=3
ALLOW_SELF_REGISTRATION=false
DEFAULT_REGISTRATION_ROLE=viewer
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MINUTES=30
BCRYPT_ROUNDS=12
MAX_UPLOAD_ROWS=2000000
UPLOAD_PREVIEW_ROWS=20
OBSERVATIONS_RETENTION_DAYS=0
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_FEEDBACK=20/hour
THROTTLE_INGEST=30/hour
THROTTLE_PROCESSING=60/hour
THROTTLE_TRAINING=10/hour
THROTTLE_REPORTS=30/hour
THROTTLE_BURST=300/hour

# ------------------------------------------------------------------------------ uploads
# nginx/earthscape.conf sets client_max_body_size to the same 50 MB.
# Change the two together, then reload nginx; a larger value here with the old nginx limit
# surfaces as an opaque HTTP 413 at the proxy.
MAX_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------------------- mongodb
MONGO_INITDB_ROOT_USERNAME=earthscape
# openssl rand -base64 24
MONGO_INITDB_ROOT_PASSWORD=
MONGODB_DATABASE=earthscape_climate
# Loopback only: the API reaches mongodb over the compose network, never through this port.
MONGODB_PORT_BIND=127.0.0.1

# Optional mongo-express (compose profile "tools"); uncomment together with that service.
# MONGO_EXPRESS_USER=admin
# MONGO_EXPRESS_PASSWORD=

# --------------------------------------------------------------------------- data lake
# "webhdfs" makes the lake live on the HDFS in this stack; set "local" to keep it on the
# artifacts volume (useful before NameNode formatting, or without the hadoop profile).
DATA_LAKE_ENGINE=webhdfs
HDFS_ROOT=/earthscape
HDFS_WEBHDFS_URL=http://hadoop-namenode:9870/webhdfs/v1
HADOOP_USER=hadoop
# Optional overrides for the paths /api/v1/processing/mapreduce prints (defaults are the
# compose service names, so a cluster outside this file needs both of them).
HDFS_NAMENODE_HOST=hadoop-namenode:9000
# HDFS_NAMENODE_URI=hdfs://hadoop-namenode:9000/earthscape

# ------------------------------------------------------------------------------- hadoop
MAPREDUCE_MODE=cluster
HADOOP_HOME=/opt/hadoop
HADOOP_STREAMING_JAR=/opt/hadoop/share/hadoop/tools/lib/hadoop-streaming-3.3.6.jar
# Directory the mapper/reducer scripts are shipped from on the node that submits Streaming
# jobs. In the backend image the repository lives at /opt/earthscape, so this is a real path.
HADOOP_STREAMING_LOCAL_ROOT=/opt/earthscape/data-pipeline/mapreduce/streaming
HADOOP_OPTS=-Dhadoop.log.dir=/opt/hadoop/logs
# Host port bindings for the Hadoop web UIs (NameNode 9870, ResourceManager 8088,
# NodeManager 8042, JobHistory 19888).
WEBHDFS_PORT=9870
HDFS_RPC_PORT=9000
HDFS_DATANODE_UI_PORT=9864
YARN_RM_PORT=8088
YARN_NM_PORT=8042
MR_HISTORY_PORT=19888

# ------------------------------------------------------------------------------- spark
# The API image only gets a JRE when SPARK_INSTALL_JDK=true; without a JVM the catalogued jobs
# attempt pyspark, fail, degrade to pandas and store engine_used=pandas with the spark_error.
SPARK_MASTER=spark://spark-master:7077
SPARK_ENGINE_PREFER=true
SPARK_INSTALL_JDK=true
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_UI_PORT=8082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1g

# ------------------------------------------------------------------------------- kafka
# KRaft (broker + controller in one process, no ZooKeeper). Compose refuses to start kafka
# until CLUSTER_ID exists: /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=
KAFKA_BROKERS=kafka:9094
KAFKA_ADVERTISED_HOST=localhost
KAFKA_HOST_PORT=9092
KAFKA_CLIMATE_TOPIC=earthscape.climate.observations
KAFKA_DEAD_LETTER_TOPIC=earthscape.climate.deadletter
KAFKA_INGEST_EVENTS_TOPIC=earthscape.ingest.events
KAFKA_ALERT_EVENTS_TOPIC=earthscape.alert.events
KAFKA_CONSUMER_GROUP=earthscape-processing
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1
KAFKA_LOG_RETENTION_HOURS=168

# Streaming consumers are opt-in: with both flags false nothing claims a consumer is running.
EVENT_STREAM_ENABLED=false
POLLER_ENABLED=false
POLL_INTERVAL_SECONDS=900

# --------------------------------------------------------------------------------- redis
REDIS_MAXMEMORY=256mb

# ------------------------------------------------------------------------------- airflow
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_METADATA_USER=airflow
# openssl rand -base64 24
AIRFLOW_METADATA_PASSWORD=
AIRFLOW_METADATA_DB=airflow
AIRFLOW_WEB_PORT=8090
AIRFLOW_ADMIN_USER=earthscape
# openssl rand -base64 24
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=ops@earthscape.local
# Service account the DAGs authenticate with. Create it in the application (role operator or
# data_engineer) - it is a real account, so the audit trail names who triggered each run.
EARTHSCAPE_API_EMAIL=
EARTHSCAPE_API_PASSWORD=
EARTHSCAPE_API_BASE_URL=http://backend:8000/api/v1
BACKUP_SCRIPT=/opt/earthscape/backup/backup_mongodump.sh

# --------------------------------------------------------------------------- monitoring
GRAFANA_ADMIN_USER=admin
# openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091
PROMETHEUS_RETENTION=15d

# ------------------------------------------------------------------------------- nginx
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
# Self-signed for local use: infrastructure/nginx/certs/ holds nothing committed; generate the
# pair with openssl and point these at it, or the 443 listener stays down.
TLS_CERT_FILE=./nginx/certs/earthscape.crt
TLS_KEY_FILE=./nginx/certs/earthscape.key

# -------------------------------------------------------------------------- frontend build
VITE_API_BASE_URL=/api/v1
VITE_MAP_TILES_URL=
VITE_MAP_ATTRIBUTION=
VITE_POLLING_INTERVAL_MS=60000

# --------------------------------------------------------------------- email (optional)
# Email stays disabled while EMAIL_HOST or DEFAULT_FROM_EMAIL is empty; no code path pretends
# to deliver mail without it.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------- provider credentials
# Fill in .env only. Providers with no token are reported as skipped, never as success.
NOAA_CDC_TOKEN=
NASA_POWER_API_KEY=
