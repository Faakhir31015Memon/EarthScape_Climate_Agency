{
  "catalogue_version": "1.0.0",
  "output_layer_root": "artifacts/datalake",
  "engine_policy": "pyspark when importable and SPARK_MASTER/SPARK_ENGINE_PREFER set; otherwise pandas fallback with identical job ids, parameters and output schemas; engine_used is recorded in every summary",
  "summary_collection": "analytics_summaries",
  "jobs": [
    {
      "id": "normalize_observations",
      "title": "Normalise & validate observations",
      "description": "Raw JSONL -> canonical observations via schema/timestamp/unit/outlier/dedupe validation; writes the validated data-lake layer and a validation report.",
      "engine": "python-validation",
      "required_inputs": ["raw JSONL observations under artifacts/datalake/raw (or explicit paths)"],
      "parameters": [
        {"name": "dataset", "type": "string", "required": false},
        {"name": "paths", "type": "list[string]", "required": false}
      ],
      "output_path": "artifacts/datalake/validated/dataset=<dataset>/year=YYYY/month=MM/observations.jsonl"
    },
    {
      "id": "profile_missing",
      "title": "Missing-value profile",
      "description": "Per-field completeness by dataset/month (absent measurements counted as missing, never zero).",
      "engine": "pyspark|pandas",
      "required_inputs": ["validated observations"],
      "parameters": [
        {"name": "dataset", "type": "string", "required": false},
        {"name": "region", "type": "string", "required": false},
        {"name": "year_from", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "year_to", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false}
      ],
      "output_path": "artifacts/datalake/analytics/dataset=<dataset>/year=YYYY/month=MM/profile_missing.parquet"
    },
    {
      "id": "aggregate_regions",
      "title": "Region x month x year aggregation",
      "description": "count/mean/min/max/sum per region, month and variable.",
      "engine": "pyspark|pandas",
      "required_inputs": ["validated observations"],
      "parameters": [
        {"name": "dataset", "type": "string", "required": false},
        {"name": "region", "type": "string", "required": false},
        {"name": "year_from", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "year_to", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "variable", "type": "enum", "values": ["temperature", "temperature_max", "temperature_min", "precipitation", "humidity", "wind_speed", "wind_direction", "pressure", "cloud_cover", "solar_radiation"], "required": false}
      ],
      "output_path": "artifacts/datalake/analytics/dataset=<dataset>/year=YYYY/month=MM/aggregate_regions.parquet"
    },
    {
      "id": "trends",
      "title": "Trend & anomaly z-scores",
      "description": "Monthly and annual means plus z-scores against per-calendar-month climatology.",
      "engine": "pyspark|pandas",
      "required_inputs": ["validated observations"],
      "parameters": [
        {"name": "dataset", "type": "string", "required": false},
        {"name": "region", "type": "string", "required": false},
        {"name": "year_from", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "year_to", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "variable", "type": "enum", "values": ["temperature", "temperature_max", "temperature_min", "precipitation", "humidity", "wind_speed", "pressure", "solar_radiation"], "required": false}
      ],
      "output_path": "artifacts/datalake/analytics/dataset=<dataset>/year=YYYY/month=MM/trends.parquet"
    },
    {
      "id": "historical_compare",
      "title": "Historical comparison vs baseline period",
      "description": "Annual means compared with a baseline climatology window (delta, delta_pct).",
      "engine": "pyspark|pandas",
      "required_inputs": ["validated observations"],
      "parameters": [
        {"name": "dataset", "type": "string", "required": false},
        {"name": "region", "type": "string", "required": false},
        {"name": "year_from", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "year_to", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "variable", "type": "enum", "values": ["temperature", "temperature_max", "temperature_min", "precipitation", "humidity", "wind_speed", "pressure", "solar_radiation"], "required": false},
        {"name": "baseline_from", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "baseline_to", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false}
      ],
      "output_path": "artifacts/datalake/analytics/dataset=<dataset>/year=YYYY/month=MM/historical_compare.parquet"
    },
    {
      "id": "anomaly_features",
      "title": "Anomaly features",
      "description": "Record-level z-scores vs region/month climatology with is_anomaly flags.",
      "engine": "pyspark|pandas",
      "required_inputs": ["validated observations"],
      "parameters": [
        {"name": "dataset", "type": "string", "required": false},
        {"name": "region", "type": "string", "required": false},
        {"name": "year_from", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "year_to", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "variable", "type": "enum", "values": ["temperature", "temperature_max", "temperature_min", "precipitation", "humidity", "wind_speed", "pressure", "solar_radiation"], "required": false},
        {"name": "z_threshold", "type": "number", "minimum": 1.0, "maximum": 5.0, "default": 2.5, "required": false}
      ],
      "output_path": "artifacts/datalake/analytics/dataset=<dataset>/year=YYYY/month=MM/anomaly_features.parquet"
    },
    {
      "id": "correlations",
      "title": "Variable correlation matrix",
      "description": "Pairwise Pearson correlations (pairwise-complete, no imputation).",
      "engine": "pyspark|pandas",
      "required_inputs": ["validated observations"],
      "parameters": [
        {"name": "dataset", "type": "string", "required": false},
        {"name": "region", "type": "string", "required": false},
        {"name": "year_from", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "year_to", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false}
      ],
      "output_path": "artifacts/datalake/analytics/dataset=<dataset>/year=YYYY/month=MM/correlations.parquet"
    },
    {
      "id": "ml_features",
      "title": "ML feature engineering",
      "description": "Lag, rolling-window and seasonal-encoding features per series for the chosen variable.",
      "engine": "pyspark|pandas",
      "required_inputs": ["validated observations"],
      "parameters": [
        {"name": "dataset", "type": "string", "required": false},
        {"name": "region", "type": "string", "required": false},
        {"name": "year_from", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "year_to", "type": "integer", "minimum": 1900, "maximum": 2100, "required": false},
        {"name": "variable", "type": "enum", "values": ["temperature", "temperature_max", "temperature_min", "precipitation", "humidity", "wind_speed", "pressure", "solar_radiation"], "required": false}
      ],
      "output_path": "artifacts/datalake/ml-features/dataset=<dataset>/year=YYYY/month=MM/ml_features_<variable>.parquet"
    }
  ]
}
