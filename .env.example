# ===========================================================================
# EarthScape Climate Agency - environment template
# Copy to .env and fill in real values. NEVER commit the .env file itself.
# Nothing here is required merely to open the local interface, except the
# MongoDB URI, which is required for any data to be stored or read.
# ===========================================================================

# --- Django core ------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma separated list of frontend origins permitted by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
LOG_BACKUP_COUNT=3

# --- Primary database: MongoDB Atlas ---------------------------------------
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local development example: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=earthscape_climate
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=1
MONGODB_SERVER_TIMEOUT_MS=4000
MONGODB_CONNECT_TIMEOUT_MS=5000

# --- JWT / sessions --------------------------------------------------------
JWT_SIGNING_KEY=replace-with-a-separate-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_ISSUER=earthscape-climate-agency

# --- Accounts and access policy --------------------------------------------
# Self-service sign-up stays closed by default; provision accounts explicitly.
ALLOW_SELF_REGISTRATION=false
DEFAULT_REGISTRATION_ROLE=viewer
PASSWORD_MIN_LENGTH=10
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MINUTES=30

# --- Rate limits (per scope) -----------------------------------------------
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_FEEDBACK=20/hour
THROTTLE_INGEST=30/hour
THROTTLE_PROCESSING=60/hour
THROTTLE_TRAINING=10/hour
THROTTLE_REPORTS=30/hour
THROTTLE_BURST=300/hour

# --- Climate data providers -------------------------------------------------
# NASA POWER needs no key; the base URL only changes for a mirror.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal
NASA_POWER_TIMEOUT_SECONDS=60
NASA_POWER_MAX_RANGE_DAYS=3650

# NOAA Climate Data Online requires a token (https://www.ncdc.noaa.gov/cdo-web/token).
NOAA_API_TOKEN=
NOAA_CDC_BASE_URL=https://www.ncdc.noaa.gov/cdo-web/api/v2
NOAA_TIMEOUT_SECONDS=45
NOAA_PAGE_SIZE=500

# Open-Meteo is keyless and is the default development/live polling source.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT_SECONDS=45

# Any additional live provider: comma separated `name:base_url` pairs.
LIVE_CLIMATE_PROVIDERS=

# --- Data lake / HDFS -------------------------------------------------------
# Engine: local (default, no cluster needed) or webhdfs.
DATA_LAKE_ENGINE=local
DATA_LAKE_ROOT=artifacts/datalake
HDFS_WEBHDFS_URL=
HADOOP_USER=hadoop
HDFS_NAMENODE_PORT=9870
HDFS_ROOT=/earthscape
HDFS_REPLICATION=1

# --- Hadoop MapReduce -------------------------------------------------------
# streaming-local runs the same mapper/reducer programs over pipes on this machine.
MAPREDUCE_MODE=streaming-local
HADOOP_BIN=
HADOOP_HOME=
HADOOP_STREAMING_JAR=

# --- Apache Spark -----------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_APP_NAME=EarthScapeClimateProcessing
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=8
PYSPARK_PYTHON=python

# --- Kafka / streaming ------------------------------------------------------
KAFKA_BROKERS=
KAFKA_CLIMATE_TOPIC=earthscape.climate.observations
KAFKA_CONSUMER_GROUP=earthscape-processing
KAFKA_DEAD_LETTER_TOPIC=earthscape.climate.deadletter
EVENT_STREAM_ENABLED=false
POLLER_ENABLED=false
POLLER_INTERVAL_SECONDS=900
CHECKPOINT_ROOT=artifacts/checkpoints

# --- Apache Airflow (scheduled pipelines, optional) ------------------------
AIRFLOW_HOME=infrastructure/airflow
AIRFLOW_DAGS_FOLDER=infrastructure/airflow/dags
AIRFLOW_SCHEDULE_INGESTION=30 6 * * *
AIRFLOW_SCHEDULE_ANALYTICS=0 7 * * *
AIRFLOW_SCHEDULE_MODEL_RETRAIN=0 8 * * 1
AIRFLOW_EXECUTOR=CeleryExecutor

# --- Background tasks (Celery + Redis, optional) ---------------------------
CELERY_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
BACKGROUND_WORKERS=4

# --- Uploads, files and storage limits -------------------------------------
MAX_UPLOAD_BYTES=209715200
MAX_UPLOAD_ROWS=2000000
UPLOAD_PREVIEW_ROWS=20
UPLOAD_TEMP_DIR=artifacts/uploads
ALLOWED_UPLOAD_EXTENSIONS=csv,xls,xlsx,json,jsonl,parquet
REPORT_STORAGE_ROOT=artifacts/reports
REPORT_DOWNLOAD_LINK_MINUTES=30
MODEL_ARTIFACT_ROOT=artifacts/models

# --- Email notifications (leave blank to keep email disabled) --------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=15

# --- Pagination, retention --------------------------------------------------
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200
OBSERVATIONS_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=365
BACKUP_DIR=artifacts/backups

# --- Frontend build ---------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=OpenStreetMap contributors
VITE_POLLING_INTERVAL_MS=30000
