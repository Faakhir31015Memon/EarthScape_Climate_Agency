<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  EarthScape Climate Agency - HDFS for a single DataNode.

  Mounted over /opt/hadoop/etc/hadoop of the hadoop-namenode and hadoop-datanode services in
  infrastructure/docker/docker-compose.yml. The two daemon volumes are hdfs-name -> /hadoop/hdfs/name
  and hdfs-data -> /hadoop/hdfs/data, which is exactly why the storage directories below point there:
  the NameNode metadata survives a container recreate, and a fresh DataNode does not have to re-replicate
  anything because nothing else holds the blocks.

  Replication is 1 because there is one DataNode. Asking for 2 would make every write hang in
  under-replication and time out, since no second node can ever hold the extra copy: the number is a
  property of this topology, not a tunable to raise casually - raise it when the compose file has a
  second datanode.

  WebHDFS (dfs.webhdfs.enabled) is the interface the application uses: backend/common/datalake.py speaks
  HTTP against http://hadoop-namenode:9870/webhdfs/v1 with user.name=${HADOOP_USER}. That is also what
  `common.datalake.status()` probes, so "reachable" only ever means a NameNode answered this endpoint.
-->
<configuration>

  <!-- One copy of every block: matches the single hadoop-datanode service. -->
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>
  <property>
    <name>dfs.namenode.replication.min</name>
    <value>1</value>
    <description>A write is satisfied by the one DataNode; without this a block would wait forever.</description>
  </property>

  <!-- NameNode namespace, on the hdfs-name volume. `-format` in the compose command only runs when
       /hadoop/hdfs/name/current/VERSION is missing, so this directory is the identity of the cluster. -->
  <property>
    <name>dfs.namenode.name.dir</name>
    <value>file:///hadoop/hdfs/name</value>
  </property>

  <!-- Data blocks, on the hdfs-data volume. Reserved space keeps the container writable: a DataNode
       that fills its volume stops serving, and the lake is the least important writer here. -->
  <property>
    <name>dfs.datanode.data.dir</name>
    <value>file:///hadoop/hdfs/data</value>
  </property>
  <property>
    <name>dfs.datanode.du.reserved</name>
    <value>2147483648</value>
    <description>2 GiB held back from HDFS so the node still has room for container logs and YARN scratch.</description>
  </property>

  <!-- A block larger than the files this project ingests (tens of MB of JSONL) simply means fewer
       blocks and fewer map tasks; 128 MiB is the upstream default and suits pseudo-distributed. -->
  <property>
    <name>dfs.blocksize</name>
    <value>134217728</value>
  </property>

  <!-- Published as ${HDFS_RPC_PORT:-9000}; must agree with fs.defaultFS in core-site.xml. -->
  <property>
    <name>dfs.namenode.rpc-address</name>
    <value>hadoop-namenode:9000</value>
  </property>

  <!-- The WebHDFS/NN UI port the health checks and the backend both use. HTTP_ONLY because there is
       no certificate infrastructure in this stack; PUBLIC means every listener binds 0.0.0.0 inside
       the container and the compose file is what decides the host binding. -->
  <property>
    <name>dfs.http.policy</name>
    <value>HTTP_ONLY</value>
  </property>
  <property>
    <name>dfs.namenode.http-address</name>
    <value>0.0.0.0:9870</value>
  </property>
  <property>
    <name>dfs.namenode.hostname</name>
    <value>hadoop-namenode</value>
    <description>Stamps block locations with the resolvable compose name rather than the container IP.</description>
  </property>

  <!-- The switch the application depends on. OPEN means an unauthenticated caller inside the compose
       network can read the lake, which is the deliberate trade-off of a local pseudo-distributed
       cluster: the ports are published on 127.0.0.1 by default, never on a public interface. -->
  <property>
    <name>dfs.webhdfs.enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.webhdfs.oauth2.enabled</name>
    <value>false</value>
  </property>

  <!-- DataNode listeners: 9866 transfer, 9867 IPC, 9864 the UI published as ${HDFS_DATANODE_UI_PORT}. -->
  <property>
    <name>dfs.datanode.address</name>
    <value>0.0.0.0:9866</value>
  </property>
  <property>
    <name>dfs.datanode.ipc.address</name>
    <value>0.0.0.0:9867</value>
  </property>
  <property>
    <name>dfs.datanode.http.address</name>
    <value>0.0.0.0:9864</value>
  </property>

  <!-- Simple authentication plus POSIX-style permissions: the API authenticates as the OS user in
       HADOOP_USER, and the hadoop-namenode startup command chmods ${HDFS_ROOT} to 777 so a container
       running as a different uid can still create its own layer directories. -->
  <property>
    <name>dfs.permissions.enabled</name>
    <value>true</value>
  </property>
  <property>
    <name>dfs.permissions.superusergroup</name>
    <value>hadoop</value>
  </property>
  <property>
    <name>dfs.namenode.acls.enabled</name>
    <value>true</value>
    <description>Lets a later deployment grant one layer to one service without widening 777.</description>
  </property>

  <!-- If the single DataNode dies, the NameNode should keep reporting it rather than decommissioning
       the cluster: with replication 1 there is no other copy to move, and pretending otherwise would
       hide real data loss. -->
  <property>
    <name>dfs.block.misreplication.processing.interval.ms</name>
    <value>10000</value>
  </property>

  <!-- The lake is re-creatable from the providers plus the ingestion jobs, so a short client timeout
       surfaces an unreachable DataNode to the API quickly instead of hanging a request. -->
  <property>
    <name>dfs.client.socket-timeout</name>
    <value>15000</value>
  </property>
  <property>
    <name>dfs.client.read.shortcircuit</name>
    <value>false</value>
    <description>Short-circuit reads need a shared unix socket directory between client and DataNode;
      the API container is not one, so the ordinary WebHDFS/TCP path is the honest setting.</description>
  </property>

  <!-- No HA: one NameNode, no journalnode, no ZooKeeper. Recorded so that `dfs.namenode.checkpoint.dir`
       questions have an answer in the file that configures this cluster. -->
  <property>
    <name>dfs.ha.automatic-failover.enabled</name>
    <value>false</value>
  </property>
  <property>
    <name>dfs.namenode.checkpoint.period</name>
    <value>3600</value>
  </property>
  <property>
    <name>dfs.namenode.checkpoint.dir</name>
    <value>file:///hadoop/hdfs/namesecondary</value>
  </property>

</configuration>
