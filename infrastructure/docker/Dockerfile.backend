# syntax=docker/dockerfile:1.6
# Backend API image: Django 5 + DRF + PyMongo over the MongoDB-only application database.
#
# Build context MUST be the repository root so `backend/requirements.txt` and the sibling
# `data-pipeline/` package (the catalogued PySpark/pandas jobs this API drives) are both
# available:
#   docker image build -f infrastructure/docker/Dockerfile.backend .
#
# Python 3.10 is pinned because the pipeline code targets 3.10 (no PEP-695 syntax, no
# nested same-quote f-strings) and pyspark 3.5.1 does not support 3.13.
FROM python:3.10-slim AS base

ARG PIP_INDEX_URL=https://pypi.org/simple
# PySpark needs a JVM at run time. The image stays small by default; enable this arg when
# the deployment should be able to attempt the Spark engine (jobs otherwise report the
# pandas fallback in `engine_used`, which is honest and supported).
ARG INSTALL_JDK=false
ARG GUNICORN_VERSION=22.0.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/earthscape/data-pipeline \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL}

# curl is used by the compose healthcheck; tini reaps the gunicorn workers so SIGTERM
# reaches them and in-flight jobs are recorded instead of vanishing.
RUN apt-get update \
 && apt-get install --no-install-recommends -y curl=7.* tini ca-certificates \
 && if [ "${INSTALL_JDK}" = "true" ]; then apt-get install --no-install-recommends -y default-jre-headless; fi \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/earthscape

# Dependency layer first: unchanged requirements reuse the cached install.
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-build-isolation -r backend/requirements.txt \
 && pip install "gunicorn==${GUNICORN_VERSION}"

# Application code: the Django backend plus the big-data packages it imports by path.
COPY backend/ ./backend/
COPY data-pipeline/ ./data-pipeline/
COPY ml/ ./ml/

# Non-root: the API never needs to write outside /opt/earthscape/artifacts.
RUN groupadd --gid 10001 earthscape \
 && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin earthscape \
 && mkdir -p /opt/earthscape/artifacts/datalake /opt/earthscape/artifacts/logs \
            /opt/earthscape/artifacts/uploads /opt/earthscape/artifacts/reports \
            /opt/earthscape/artifacts/models /opt/earthscape/artifacts/checkpoints \
 && chown -R earthscape:earthscape /opt/earthscape
USER earthscape

# No Django migrations exist (MongoDB is the only application database), so the entrypoint
# starts gunicorn directly. `--check` runs first: the process exits non-zero if the URL
# configuration or the Mongo wiring is broken instead of serving a half-working app.
WORKDIR /opt/earthscape/backend
EXPOSE 8000
ENV GUNICORN_BIND=0.0.0.0:8000 \
    GUNICORN_WORKERS=3 \
    GUNICORN_TIMEOUT=120 \
    GUNICORN_GRACEFUL_TIMEOUT=30 \
    GUNICORN_MAX_REQUESTS=1000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "python manage.py check --fail-level ERROR && exec gunicorn config.wsgi:application --bind ${GUNICORN_BIND} --workers ${GUNICORN_WORKERS} --timeout ${GUNICORN_TIMEOUT} --graceful-timeout ${GUNICORN_GRACEFUL_TIMEOUT} --max-requests ${GUNICORN_MAX_REQUESTS} --max-requests-jitter 100 --access-logfile - --error-logfile - --log-level info"]
